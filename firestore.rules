rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function activityAdmin() {
      return owner('sUf2WIFGJfRXg5ZmlZEwy2nxMoG3');
    }
    function ownsPresence(id) {
      return request.auth != null && id.matches(request.auth.uid + '_[a-f0-9-]{36}');
    }
    function validPresence() {
      let s = request.resource.data;
      return s.keys().hasOnly(['uid', 'email', 'practicing', 'seenAt'])
        && owner(s.uid)
        && s.email is string && s.email.size() <= 254 && s.email == request.auth.token.email
        && s.practicing is bool
        && s.seenAt is int && s.seenAt >= request.time.toMillis() - 120000
        && s.seenAt <= request.time.toMillis() + 60000;
    }
    function validActivityBatch(id) {
      let s = request.resource.data;
      let count = s.lesson + s.quiz + s.review + s.warmup;
      return owner(s.uid)
        && id.matches(s.uid + '_[a-f0-9-]{36}')
        && s.keys().hasAll(['uid', 'email', 'day', 'lastAt', 'activeMs', 'lesson', 'quiz', 'review', 'warmup',
          'correct', 'timedQuiz', 'quizMs', 'timedSignedReview', 'signedReviewMs', 'quizRuns', 'quizPasses',
          'timedPasses', 'passedQuizMs'])
        && s.keys().hasOnly(['uid', 'email', 'day', 'lastAt', 'activeMs', 'lesson', 'quiz', 'review', 'warmup',
          'correct', 'timedQuiz', 'quizMs', 'timedSignedReview', 'signedReviewMs', 'quizRuns', 'quizPasses',
          'timedPasses', 'passedQuizMs', 'timedReview', 'reviewMs', 'excludedReview', 'timedFilteredSignedReview',
          'filteredSignedReviewMs', 'timedPemdasQuiz', 'pemdasQuizMs', 'pemdasQuizRuns', 'pemdasQuizPasses',
          'timedPemdasPasses', 'passedPemdasQuizMs', 'timedFilteredPemdasReview', 'filteredPemdasReviewMs'])
        && s.email == request.auth.token.email && s.email is string && s.email.size() <= 254
        && s.day is string && s.day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && s.lastAt is int && s.lastAt > 0 && s.lastAt <= request.time.toMillis() + 300000
        && validScore(s, 'activeMs', 90000000)
        && validScore(s, 'lesson', 10000) && validScore(s, 'quiz', 10000)
        && validScore(s, 'review', 10000) && validScore(s, 'warmup', 10000)
        && validScore(s, 'correct', count)
        && validScore(s, 'timedQuiz', s.quiz) && validScore(s, 'quizMs', 90000000)
        && validScore(s, 'timedSignedReview', s.review) && validScore(s, 'signedReviewMs', 90000000)
        && validScore(s, 'timedReview', s.review) && validScore(s, 'excludedReview', s.review - score(s, 'timedReview'))
        && validScore(s, 'reviewMs', score(s, 'timedReview') * 120000)
        && validScore(s, 'timedFilteredSignedReview', score(s, 'timedReview'))
        && validScore(s, 'filteredSignedReviewMs', score(s, 'reviewMs'))
        && validScore(s, 'filteredSignedReviewMs', score(s, 'timedFilteredSignedReview') * 120000)
        && validScore(s, 'quizRuns', s.quiz) && validScore(s, 'quizPasses', s.quizRuns)
        && validScore(s, 'timedPasses', s.quizPasses) && validScore(s, 'passedQuizMs', 90000000)
        && validScore(s, 'timedPemdasQuiz', s.quiz - s.timedQuiz) && validScore(s, 'pemdasQuizMs', 90000000)
        && validScore(s, 'pemdasQuizRuns', s.quiz - s.quizRuns)
        && validScore(s, 'pemdasQuizPasses', score(s, 'pemdasQuizRuns'))
        && validScore(s, 'timedPemdasPasses', score(s, 'pemdasQuizPasses')) && validScore(s, 'passedPemdasQuizMs', 90000000)
        && validScore(s, 'timedFilteredPemdasReview', score(s, 'timedReview') - score(s, 'timedFilteredSignedReview'))
        && validScore(s, 'filteredPemdasReviewMs', score(s, 'reviewMs') - score(s, 'filteredSignedReviewMs'))
        && validScore(s, 'filteredPemdasReviewMs', score(s, 'timedFilteredPemdasReview') * 120000);
    }
    function score(scores, key) { return scores.get(key, 0); }
    function validScore(scores, key, maxValue) {
      let value = scores.get(key, 0);
      return value is int && value >= 0 && value <= maxValue;
    }
    function validActivityScores(scores) {
      return scores is map
        && scores.keys().hasOnly(['signedQuizBest', 'signedQuizPassed', 'pemdasQuizBest', 'pemdasQuizPassed', 'fractions', 'integers', 'pemdas', 'factors'])
        && validScore(scores, 'signedQuizBest', 20)
        && score(scores, 'signedQuizPassed') in [0, 10, 15, 20]
        && validScore(scores, 'pemdasQuizBest', 10)
        && score(scores, 'pemdasQuizPassed') in [0, 10]
        && validScore(scores, 'fractions', 1000000) && validScore(scores, 'integers', 1000000)
        && validScore(scores, 'pemdas', 1000000) && validScore(scores, 'factors', 1000000);
    }
    function keepsActivityScores() {
      let before = resource.data.data.get('activityScores', {});
      let after = request.resource.data.data.get('activityScores', {});
      return score(after, 'signedQuizBest') >= score(before, 'signedQuizBest')
        && score(after, 'signedQuizPassed') >= score(before, 'signedQuizPassed')
        && score(after, 'pemdasQuizBest') >= score(before, 'pemdasQuizBest')
        && score(after, 'pemdasQuizPassed') >= score(before, 'pemdasQuizPassed')
        && score(after, 'fractions') >= score(before, 'fractions')
        && score(after, 'integers') >= score(before, 'integers')
        && score(after, 'pemdas') >= score(before, 'pemdas')
        && score(after, 'factors') >= score(before, 'factors');
    }
    function validSave() {
      let s = request.resource.data;
      return s.keys().hasOnly(['version', 'epoch', 'revision', 'data', 'updatedAt'])
        && s.version == 1
        && s.epoch is int && s.epoch >= 0
        && s.revision is int && s.revision > 0
        && s.updatedAt == request.time
        && s.data is map
        && s.data.keys().hasAll(['version', 'lesson', 'progress', 'game'])
        && s.data.keys().hasOnly(['version', 'lesson', 'progress', 'game', 'activityScores'])
        && validActivityScores(s.data.get('activityScores', {}))
        && s.data.version == 1
        && (s.data.lesson == null || (s.data.lesson is string && s.data.lesson.size() <= 100))
        && s.data.progress is map && s.data.progress.size() <= 200
        && s.data.game is map && s.data.game.keys().hasOnly(['streak', 'best'])
        && s.data.game.streak is int && s.data.game.streak >= 0 && s.data.game.streak <= 1000000
        && s.data.game.best is int && s.data.game.best >= 0 && s.data.game.best <= 1000000;
    }
    function cleared() {
      let d = request.resource.data.data;
      return d.progress.size() == 0 && d.lesson == null && d.game.best == 0 && d.game.streak == 0
        && d.get('activityScores', {}).size() == 0;
    }
    function validPracticeSummary(uid) {
      let s = request.resource.data;
      let path = /databases/$(database)/documents/progress/$(uid);
      let save = exists(path) ? get(path).data : {};
      let data = save.get('data', {});
      let scores = data.get('activityScores', {});
      return s.keys().hasOnly(['email', 'revision', 'completedLessons', 'reviewBest'])
        && s.email is string && s.email.size() <= 254 && s.email == request.auth.token.email
        && s.revision is int && s.revision == save.get('revision', 0)
        && s.completedLessons is int && s.completedLessons >= 0
        && s.completedLessons <= data.get('progress', {}).size()
        && s.reviewBest is map && s.reviewBest == {
          'fractions': score(scores, 'fractions'), 'integers': score(scores, 'integers'),
          'pemdas': score(scores, 'pemdas'), 'factors': score(scores, 'factors')
        };
    }
    match /practiceActivity/{id} {
      allow read: if activityAdmin();
      allow create: if validActivityBatch(id);
      // Repeat offline uploads leave the original batch unchanged.
      allow update: if owner(resource.data.uid) && request.resource.data == resource.data;
    }
    match /practicePresence/{id} {
      allow read: if activityAdmin();
      allow create, update: if ownsPresence(id) && validPresence();
      allow delete: if ownsPresence(id);
    }
    match /practiceSummaries/{uid} {
      allow read: if activityAdmin();
      allow create, update: if owner(uid) && validPracticeSummary(uid);
    }
    match /progress/{uid} {
      allow read: if owner(uid);
      allow create: if owner(uid) && validSave()
        && request.resource.data.revision == 1
        && (request.resource.data.epoch == 0 || (request.resource.data.epoch == 1 && cleared()));
      allow update: if owner(uid) && validSave()
        && request.resource.data.revision == resource.data.revision + 1
        && ((request.resource.data.epoch == resource.data.epoch && keepsActivityScores())
          || (request.resource.data.epoch == resource.data.epoch + 1 && cleared()));
      // Reset uses a new epoch rather than deleting the document. Old offline
      // devices must observe the tombstone before they can upload more work.
      allow delete: if false;
    }
  }
}
