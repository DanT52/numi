rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function score(scores, key) { return scores.get(key, 0); }
    function validScore(scores, key, maxValue) {
      return score(scores, key) is int && score(scores, key) >= 0 && score(scores, key) <= maxValue;
    }
    function validActivityScores(scores) {
      return scores is map
        && scores.keys().hasOnly(['signedQuizBest', 'signedQuizPassed', 'fractions', 'integers', 'pemdas', 'factors'])
        && validScore(scores, 'signedQuizBest', 20)
        && score(scores, 'signedQuizPassed') in [0, 10, 15, 20]
        && validScore(scores, 'fractions', 1000000) && validScore(scores, 'integers', 1000000)
        && validScore(scores, 'pemdas', 1000000) && validScore(scores, 'factors', 1000000);
    }
    function keepsActivityScores() {
      let before = resource.data.data.get('activityScores', {});
      let after = request.resource.data.data.get('activityScores', {});
      return score(after, 'signedQuizBest') >= score(before, 'signedQuizBest')
        && score(after, 'signedQuizPassed') >= score(before, 'signedQuizPassed')
        && score(after, 'fractions') >= score(before, 'fractions')
        && score(after, 'integers') >= score(before, 'integers')
        && score(after, 'pemdas') >= score(before, 'pemdas')
        && score(after, 'factors') >= score(before, 'factors');
    }
    function validSave() {
      let s = request.resource.data;
      return s.keys().hasOnly(['version', 'epoch', 'revision', 'data', 'updatedAt'])
        && s.version == 1
        && s.epoch is int && s.epoch >= 0
        && s.revision is int && s.revision > 0
        && s.updatedAt == request.time
        && s.data is map
        && s.data.keys().hasAll(['version', 'lesson', 'progress', 'game'])
        && s.data.keys().hasOnly(['version', 'lesson', 'progress', 'game', 'activityScores'])
        && validActivityScores(s.data.get('activityScores', {}))
        && s.data.version == 1
        && (s.data.lesson == null || (s.data.lesson is string && s.data.lesson.size() <= 100))
        && s.data.progress is map && s.data.progress.size() <= 200
        && s.data.game is map && s.data.game.keys().hasOnly(['streak', 'best'])
        && s.data.game.streak is int && s.data.game.streak >= 0 && s.data.game.streak <= 1000000
        && s.data.game.best is int && s.data.game.best >= 0 && s.data.game.best <= 1000000;
    }
    function cleared() {
      let d = request.resource.data.data;
      return d.progress.size() == 0 && d.lesson == null && d.game.best == 0 && d.game.streak == 0
        && d.get('activityScores', {}).size() == 0;
    }
    match /progress/{uid} {
      allow read: if owner(uid);
      allow create: if owner(uid) && validSave()
        && request.resource.data.revision == 1
        && (request.resource.data.epoch == 0 || (request.resource.data.epoch == 1 && cleared()));
      allow update: if owner(uid) && validSave()
        && request.resource.data.revision == resource.data.revision + 1
        && ((request.resource.data.epoch == resource.data.epoch && keepsActivityScores())
          || (request.resource.data.epoch == resource.data.epoch + 1 && cleared()));
      // Reset uses a new epoch rather than deleting the document. Old offline
      // devices must observe the tombstone before they can upload more work.
      allow delete: if false;
    }
  }
}
